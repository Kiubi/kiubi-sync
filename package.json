{
  "name": "kiubi-sync",
  "version": "0.1.5",
  "description": "Aide à la publication de thème graphique personnalisé sur Kiubi",
  "main": "index.js",
  "scripts": {
    "lint": "eslint \"./index.js\" \"./src/\" \"./test/\"",
    "lint-fix": "eslint --fix \"./index.js\" \"./src/\" \"./test/\"",
    "test": "npm run lint && node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" \"test/**/*.test.js\""
  },
  "author": "Sebastien BRAUN <sebastien@kiubi.com> (https://www.kiubi.com)",
  "homepage": "https://github.com/Kiubi/kiubi-sync",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kiubi/kiubi-sync.git"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "byte-size": "^7.0.0",
    "chalk": "^4.1.0",
    "lodash": "^4.17.20"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "ftp-srv": "^4.6.3"
  }
}
